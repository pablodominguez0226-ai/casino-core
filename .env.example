# Application Configuration
PROJECT_NAME="CasinoCore"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="casinocore"
POSTGRES_USER="casinocore_user"
POSTGRES_PASSWORD="casinocore_password"
POSTGRES_ECHO=false

# Security & Authentication
SECRET_KEY="casinocore-super-secure-jwt-secret-key-at-least-32-chars-long!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
